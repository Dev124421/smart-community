<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#232428"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Banner + Overlapping Avatar -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="120dp">

            <ImageView
                android:id="@+id/iv_banner"
                android:layout_width="match_parent"
                android:layout_height="95dp"
                android:scaleType="centerCrop"
                android:src="@color/pink"/>

            <TextView
                android:id="@+id/iv_community_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_card_dark"
                android:backgroundTint="@color/pink"
                android:textSize="16dp"
                android:text="H"
                android:textColor="@color/white" />
        </FrameLayout>

        <!-- Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="14dp"
            android:paddingBottom="14dp">

            <!-- Server Name & Verified Check -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/online"
                    app:tint="#23A55A" />

                <TextView
                    android:id="@+id/tv_community_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Heartopia"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Description -->
            <TextView
                android:id="@+id/tv_community_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="2dp"
                android:text="Heartopia Official Discord where you can contact official group and communicate with other players here."
                android:textColor="#9E9E9E"
                android:textSize="11.5sp" />

            <!-- Stats (Online / Members) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/online" />

                <TextView
                    android:id="@+id/tv_online_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="100,667 Online"
                    android:textColor="#9E9E9E"
                    android:textSize="10.5sp" />

                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="14dp"
                    android:background="#757575" />

                <TextView
                    android:id="@+id/tv_members_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="809,729 Members"
                    android:textColor="#9E9E9E"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Preview Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_preview"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#7C4DFF"
                android:text="Preview"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="12.5sp"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>