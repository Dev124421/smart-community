<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:paddingTop="15dp"
    android:paddingBottom="25dp">
    <LinearLayout
        android:id="@+id/left_rail"
        android:layout_width="72dp"
        android:layout_height="0dp"
        android:background="@color/black"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="36dp"
        app:layout_constraintBottom_toTopOf="@id/bottom_account_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <FrameLayout
            android:id="@+id/btn_dm"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_card_dark"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_dm"
                app:tint="@color/white" />
        </FrameLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_server_rail"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingTop="10dp"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:itemCount="4"
            tools:listitem="@layout/item_rail_server" />
        <FrameLayout
            android:id="@+id/btn_add_server"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_card_dark"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/add"
                app:tint="@color/white" />
        </FrameLayout>
    </LinearLayout>
    <androidx.core.widget.NestedScrollView
        android:id="@+id/main_scroll_content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_home"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/bottom_account_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/left_rail"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="25dp"
            android:paddingTop="20dp"
            android:paddingBottom="25dp">
            <TextView
                android:id="@+id/tv_title_servers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Servers"
                android:textColor="@color/warm_white"
                android:textSize="22sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Create a place for you and your friends"
                android:textColor="@color/soft_border"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:text="Servers are where you and your friends hang out. Make yours and start talking."
                android:textColor="@color/soft_border"
                android:textSize="11.5sp" />
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <LinearLayout
                        android:id="@+id/card_hanging_out"
                        android:layout_width="160dp"
                        android:layout_height="170dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_card_dark"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="65dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_hanging_out" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Hanging Out"
                            android:textColor="@color/warm_white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Discover new friends, exchange laughs, and make every hangout feel like time well spent."
                            android:textColor="@color/soft_border"
                            android:textSize="9.5sp" />
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/card_gaming"
                        android:layout_width="160dp"
                        android:layout_height="170dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_card_dark"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="65dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/gaming2" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Gaming"
                            android:textColor="@color/warm_white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Team up with friends, take on exciting challenges, and turn every match into a new memory."
                            android:textColor="@color/soft_border"
                            android:textSize="9.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_music"
                        android:layout_width="160dp"
                        android:layout_height="170dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_card_dark"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="65dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_music" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Music"
                            android:textColor="@color/warm_white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Share tracks, collaborate on playlists, and vibe with other listeners."
                            android:textColor="@color/soft_border"
                            android:textSize="9.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_study"
                        android:layout_width="160dp"
                        android:layout_height="170dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_card_dark"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="65dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_study" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Study &amp; Learn"
                            android:textColor="@color/warm_white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Study together, share notes, organize study sessions, and reach your goals."
                            android:textColor="@color/soft_border"
                            android:textSize="9.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_movie"
                        android:layout_width="160dp"
                        android:layout_height="170dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_card_dark"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="65dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_movie" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Movie &amp; TV"
                            android:textColor="@color/warm_white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Host watch parties, talk about the latest releases, and rate favorite films."
                            android:textColor="@color/soft_border"
                            android:textSize="9.5sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/card_work"
                        android:layout_width="160dp"
                        android:layout_height="170dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_card_dark"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="65dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/ic_work_yappy" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="Work &amp; Projects"
                            android:textColor="@color/warm_white"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Collaborate on projects, manage tasks, brainstorm, and build together."
                            android:textColor="@color/soft_border"
                            android:textSize="9.5sp" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_server"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="@color/purple"
                android:text="Create a server"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:cornerRadius="22dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_invite_link"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#2B2D31"
                android:text="I have an invite link"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp"
                app:cornerRadius="22dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Join communities"
                android:textColor="@color/warm_white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Check out these servers we think you may like. Find game tips, teammates and more."
                android:textColor="@color/soft_border"
                android:textSize="11.5sp" />
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_joined_communities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:nestedScrollingEnabled="false"
                tools:itemCount="1"
                tools:listitem="@layout/item_server_community" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/bottom_account_bar"
        android:name="com.example.yappy.BottomAccountBarFragment"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>