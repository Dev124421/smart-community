<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".personalMessage"
    android:background="@color/black">
    
    <LinearLayout
        android:layout_width="76dp"
        android:layout_height="match_parent"
        android:background="@color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/dm"
            android:layout_width="45dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_card_dark"
            android:backgroundTint="@color/pink"
            android:clickable="true"
            android:layout_marginTop="45dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_dm"
                android:layout_marginTop="12.27dp"
                android:layout_marginLeft="10.97dp"/>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/SS"
            android:layout_width="45dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_card_dark"
            android:layout_marginTop="9dp"
            android:clickable="true">

            <TextView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:text="SS"
                android:textColor="@color/white"
                android:textSize="15dp"
                android:layout_marginTop="10dp"
                android:layout_marginLeft="12.5dp"/>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/moba"
            android:layout_width="45dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_card_dark"
            android:layout_marginTop="9dp"
            android:clickable="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/moba_img"/>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/B"
            android:layout_width="45dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_card_dark"
            android:layout_marginTop="9dp"
            android:clickable="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/rainbow"/>

        </FrameLayout>

        <FrameLayout
            android:id="@+id/add"
            android:layout_width="45dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_card_dark"
            android:layout_marginTop="9dp"
            android:clickable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/add"
                android:layout_marginTop="11.58dp"
                android:layout_marginLeft="12.08dp"/>

        </FrameLayout>
    </LinearLayout>
    
    <LinearLayout
        android:id="@+id/account_schortcut"
        android:layout_width="match_parent"
        android:layout_height="59dp"
        android:clickable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:orientation="horizontal"
        android:elevation="15dp">
        
        <ImageView
            android:layout_width="61.94dp"
            android:layout_height="58.68dp"
            android:src="@drawable/dm_account_logo"
            android:layout_marginLeft="9dp"/>
        
        <ImageView
            android:layout_width="16dp"
            android:layout_height="15dp"
            android:src="@drawable/online"
            android:layout_marginLeft="-20dp"
            android:layout_marginTop="45dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="10dp">

            <TextView
                android:id="@+id/username"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User"
                android:textStyle="bold"
                android:textSize="13.38dp"
                android:textColor="@color/white"/>
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textSize="9.07dp"
                android:text="Online"/>

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="7dp"
                android:src="@drawable/forward_arrow"
                android:rotation="90"
                android:layout_marginLeft="30dp"
                android:layout_marginTop="-25dp"/>

        </LinearLayout>

            <ImageView
                android:id="@+id/notification"
                android:layout_width="16.1dp"
                android:layout_height="16.1dp"
                android:src="@drawable/notification"
                android:layout_marginTop="20dp"
                android:clickable="true"
                android:layout_marginLeft="200dp"
                android:layout_marginRight="20dp"/>
        
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/maincontent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="76dp"
        android:layout_marginBottom="59dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_home"
        android:orientation="vertical"
        android:paddingLeft="13dp">

        <TextView
            android:id="@+id/Message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:text="Messages"
            android:textSize="23dp"
            android:layout_marginTop="30dp"
            android:layout_marginLeft="10dp"
            app:layout_constraintTop_toTopOf="@id/maincontent"
            app:layout_constraintStart_toStartOf="@id/maincontent"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="15dp"
            app:layout_constraintTop_toBottomOf="@id/Message">
            
            <LinearLayout
                android:id="@+id/search"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_chat_inactive_squircle"
                android:gravity="center"
                android:clickable="true">

                <ImageView
                    android:layout_width="14.75dp"
                    android:layout_height="14.75dp"
                    android:src="@drawable/search"/>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/add_friends"
                android:layout_width="204.8dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_chat_inactive_squircle"
                android:layout_marginLeft="9dp"
                android:gravity="center"
                android:clickable="true">

                <ImageView
                    android:layout_width="18.64dp"
                    android:layout_height="18.64dp"
                    android:src="@drawable/add_friend"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12.87dp"
                    android:text="Add Friends"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    android:layout_marginLeft="7dp"/>

            </LinearLayout>
            
            <LinearLayout
                android:id="@+id/new_message"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_chat_inactive_squircle"
                android:layout_marginLeft="9dp"
                android:gravity="center"
                android:clickable="true">
                
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+"
                    android:textSize="20dp"
                    android:textColor="@color/white"/>
                
            </LinearLayout>
            
        </LinearLayout>
        
        <LinearLayout
            android:id="@+id/community_shortcut"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginTop="125dp"
            android:background="@drawable/bg_communities"
            app:layout_constraintTop_toTopOf="@id/maincontent"
            app:layout_constraintStart_toStartOf="@id/maincontent"
            android:gravity="center">
            
            <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:src="@drawable/logo"/>
            
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/rv_messages"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="15dp"
                android:text="Invite more friends"
                android:textColor="@color/white"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/export"
                android:layout_width="19.1dp"
                android:layout_height="19.1dp"
                android:src="@drawable/export"
                android:layout_marginLeft="121.87dp"
                android:clickable="true"/>
            
            <ImageView
                android:id="@+id/share"
                android:layout_width="17.51dp"
                android:layout_height="17.51dp"
                android:src="@drawable/share"
                android:layout_marginLeft="16.22dp"
                android:clickable="true"/>

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_messages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/community_shortcut"
            tools:listitem="@layout/item_message"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>