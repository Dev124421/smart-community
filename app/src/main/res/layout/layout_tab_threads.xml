<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">
    <TextView
        android:id="@+id/tv_threads_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="There are no threads."
        android:textColor="@color/warm_white"
        android:textSize="18sp"
        android:textStyle="bold" />
    <TextView
        android:id="@+id/tv_threads_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:maxWidth="280dp"
        android:text="Stay focused on a conversation with a thread - a temporary text channel."
        android:textColor="@color/soft_border"
        android:textSize="13sp" />
    <Button
        android:id="@+id/btn_create_thread"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/pink"
        android:paddingHorizontal="24dp"
        android:text="Create thread"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="22dp" />

</LinearLayout>