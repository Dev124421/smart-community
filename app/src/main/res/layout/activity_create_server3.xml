<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".CreateServer3"
    android:background="@color/black"
    android:paddingHorizontal="25dp"
    android:paddingTop="15dp"
    android:paddingBottom="25dp">
    
    <ImageView
        android:id="@+id/back_arrow"
        android:layout_width="22.5dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_arrow_back"
        android:layout_marginTop="23dp"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginLeft="7dp"
        app:layout_constraintStart_toStartOf="parent"
        android:clickable="true"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/head"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textColor="@color/warm_white"
        android:text="Create Your Server"
        android:textSize="26.61dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@id/back_arrow"/>

    <TextView
        android:id="@+id/subhead"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12dp"
        android:text="Your server is where you and your friends hang out. Make \nyours and start talking."
        android:textColor="@color/soft_border"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/head"
        android:layout_marginTop="9dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <LinearLayout
        android:id="@+id/icon_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/subhead"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="25dp">

        <ImageView
            android:id="@+id/add_icon"
            android:layout_width="65.52dp"
            android:layout_height="58.46dp"
            android:src="@drawable/add_icon"
            android:clickable="true"/>
        
        <ImageView
            android:id="@+id/gaming_icon"
            android:layout_width="65.52dp"
            android:layout_height="58.46dp"
            android:src="@drawable/gaming2"
            android:layout_marginLeft="14.62dp"
            android:clickable="true"/>

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/warm_white"
        android:text="Server Name"
        android:textSize="18.75dp"
        app:layout_constraintTop_toBottomOf="@id/icon_layout"
        android:layout_marginTop="12dp"/>

    <EditText
        android:id="@+id/server_name"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/input_box_2"
        android:hint="User's server"
        android:inputType="text"
        android:textColor="@color/warm_white"
        android:textColorHint="@color/soft_border"
        android:layout_marginTop="46dp"
        app:layout_constraintTop_toBottomOf="@id/icon_layout"
        android:paddingHorizontal="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14.23dp"
        app:layout_constraintTop_toBottomOf="@id/server_name"
        app:layout_constraintStart_toStartOf="parent"
        android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="By creating a server, you agree to Yappy’s "
        android:textColor="@color/soft_border"
        android:textSize="10dp"/>

    <TextView
        android:id="@+id/guidelines"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="10dp"
        android:textColor="@color/pink"
        android:text="Community Guidelines."
        android:clickable="true"/>

    </LinearLayout>

    <Button
        android:id="@+id/createBtn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:background="@drawable/input_box_2"
        android:backgroundTint="@color/pink"
        android:text="Create Server"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="19.93dp"
        android:clickable="true"
        android:layout_marginTop="61.12dp"
        app:layout_constraintTop_toBottomOf="@id/server_name"/>
    
</androidx.constraintlayout.widget.ConstraintLayout>